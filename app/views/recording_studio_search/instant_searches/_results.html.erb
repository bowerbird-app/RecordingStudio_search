<% query = local_assigns.fetch(:query, "") %>
<% collections = instant_search_result_collections(hits) %>
<% if collections.empty? %>
  <% if query.to_s.strip.empty? %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: RecordingStudio.t("recording_studio.search.results.empty.title"),
      description: RecordingStudio.t("recording_studio.search.results.empty.description")
    ) %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: RecordingStudio.t("recording_studio.search.results.no_hits.title"),
      description: RecordingStudio.t("recording_studio.search.results.no_hits.description")
    ) %>
  <% end %>
<% else %>
  <% collections.each do |label, rows| %>
    <% if collections.many? %>
      <%= render FlatPack::SectionTitle::Component.new(
        title: instant_search_translated_collection_label(label)
      ) %>
    <% end %>
    <%= render FlatPack::Table::Component.new(data: rows.to_a, class: "text-sm") do |table| %>
      <% table.column(title: RecordingStudio.t("recording_studio.search.results.columns.name")) { |row| instant_search_row_name(row) } %>
      <% table.column(title: RecordingStudio.t("recording_studio.search.results.columns.detail")) { |row| instant_search_row_detail(row) } %>
    <% end %>
  <% end %>
<% end %>
