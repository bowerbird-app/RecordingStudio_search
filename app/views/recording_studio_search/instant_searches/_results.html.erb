<% query = local_assigns.fetch(:query, "") %>
<% collections = instant_search_result_collections(hits) %>
<% if collections.empty? %>
  <% if query.to_s.strip.empty? %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: t("recording_studio.search.results.empty.title", default: "Type a little"),
      description: t("recording_studio.search.results.empty.description", default: "Hits land here as you go.")
    ) %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: t("recording_studio.search.results.no_hits.title", default: "No luck"),
      description: t("recording_studio.search.results.no_hits.description", default: "Try another word. Typos are fine.")
    ) %>
  <% end %>
<% else %>
  <% collections.each do |label, rows| %>
    <% if collections.many? %>
      <%= render FlatPack::SectionTitle::Component.new(
        title: instant_search_translated_collection_label(label)
      ) %>
    <% end %>
    <%= render FlatPack::Table::Component.new(data: rows.to_a, class: "text-sm") do |table| %>
      <% table.column(title: t("recording_studio.search.results.columns.name", default: "Name")) { |row| instant_search_row_name(row) } %>
      <% table.column(title: t("recording_studio.search.results.columns.detail", default: "Detail")) { |row| instant_search_row_detail(row) } %>
    <% end %>
  <% end %>
<% end %>
