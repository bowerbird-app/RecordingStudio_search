<% dummy_page_nav(
  title: "Methods",
  subtitle: "Call search from any host page. One model or several.",
  back_url: root_path
) %>

<div class="flex w-full flex-col gap-6">

  <%= render FlatPack::SectionTitle::Component.new(
    title: "One model",
    subtitle: "User.search",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Dummy /people uses this. A person is not a recording, so the
      # lookup opts out of the access scope. Skip search when the box is empty.
      @q = params[:q].to_s
      @people = @q.present? ? User.search(@q, limit: 20, unscoped: true) : User.none
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Several models",
    subtitle: "RecordingStudioSearch.search",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Dummy home keeps each type in its own list.
      @users = User.search(@q, limit: 20, unscoped: true)
      @pages = Page.search(@q, actor: Current.actor, root: current_root_recording, limit: 20)
      @notes = Note.search(@q, limit: 20, unscoped: true)
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Scope",
    subtitle: "Search inside a relation",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      User.where("email ILIKE ?", "%@example.com").search(@q, unscoped: true)
      RecordingStudioSearch.search(
        Page.where.not(body: nil),
        @q,
        actor: Current.actor,
        root: current_root_recording
      )

      # Dummy /groups searches people already in a mailbox.
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Weights",
    subtitle: "Title can beat body",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Dummy Page and /title-first use this. A–D are Postgres tsvector weights.
      searchable backend: :pgvector, against: { title: "A", body: "D" }
    CODE
  ) %>
</div>
