<% dummy_page_nav(title: "Methods", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Methods",
    subtitle: "Call search from any host page. One model or several.",
    variant: :h1
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "One model",
    subtitle: "User.search",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Dummy /people uses this. Blank q returns the full relation,
      # so a lookup page should skip search when the box is empty.
      @q = params[:q].to_s
      @people = @q.present? ? User.search(@q, limit: 20) : User.none
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Several models",
    subtitle: "RecordingStudioSearch.search",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Dummy home keeps each type in its own list.
      results = RecordingStudioSearch.search([User, Page, Note], @q, limit: 20)
      @users = results[User]
      @pages = results[Page]
      @notes = results[Note]
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Scope",
    subtitle: "Search inside a relation",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      User.where("email ILIKE ?", "%@example.com").search(@q)
      RecordingStudioSearch.search(Page.where.not(body: nil), @q)

      # Dummy /groups searches people already in a mailbox.
    CODE
  ) %>

  <%= render FlatPack::SectionTitle::Component.new(
    title: "Weights",
    subtitle: "Title can beat body",
  ) %>

  <%= render FlatPack::CodeBlock::Component.new(
    language: :ruby,
    code: <<~'CODE'
      # Dummy Page and /title-first use this. A–D are Postgres tsvector weights.
      searchable backend: :pgvector, against: { title: "A", body: "D" }
    CODE
  ) %>
</div>
