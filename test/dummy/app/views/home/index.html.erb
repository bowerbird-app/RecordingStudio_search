<% dummy_page_nav(title: "Search", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Search",
    subtitle: "People by name. Pages by meaning. Notes by title.",
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get do %>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
      <%= render FlatPack::TextInput::Component.new(
        name: "q",
        label: "Look up",
        value: @q,
        placeholder: "Try Ada, refund, sticky"
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Search",
        style: :primary,
        size: :md,
        type: "submit"
      ) %>
    </div>
  <% end %>

  <% if @q.blank? %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: "Type something first",
      description: "Blank search leaves the list alone. Add a word to see hits."
    ) %>
  <% else %>
    <%= render FlatPack::SectionTitle::Component.new(title: "People") %>
    <% if @users.any? %>
      <%= render FlatPack::Table::Component.new(data: @users.to_a, class: "text-sm") do |table| %>
        <% table.column(title: "Name") { |user| user.name.presence || "—" } %>
        <% table.column(title: "Email") { |user| user.email } %>
      <% end %>
    <% else %>
      <%= render FlatPack::Alert::Component.new(
        style: :info,
        title: "No people match",
        description: "Try a name or email, typos included."
      ) %>
    <% end %>

    <%= render FlatPack::SectionTitle::Component.new(title: "Pages") %>
    <% if @pages.any? %>
      <%= render FlatPack::Table::Component.new(data: @pages.to_a, class: "text-sm") do |table| %>
        <% table.column(title: "Title") { |page| page.title } %>
        <% table.column(title: "Body") { |page| page.body.to_s.truncate(80) } %>
      <% end %>
    <% else %>
      <%= render FlatPack::Alert::Component.new(
        style: :info,
        title: "No pages match",
        description: "If meaning search is cold, we fall back to the words on the page."
      ) %>
    <% end %>

    <%= render FlatPack::SectionTitle::Component.new(title: "Notes") %>
    <% if @notes.any? %>
      <%= render FlatPack::Table::Component.new(data: @notes.to_a, class: "text-sm") do |table| %>
        <% table.column(title: "Title") { |note| note.title } %>
      <% end %>
    <% else %>
      <%= render FlatPack::Alert::Component.new(
        style: :info,
        title: "No notes match",
        description: "Notes only look at the title."
      ) %>
    <% end %>
  <% end %>
</div>
