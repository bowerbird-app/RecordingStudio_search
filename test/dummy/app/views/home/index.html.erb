<% dummy_page_nav(title: "Search", back_url: root_path) %>

<div class="flex w-full flex-col items-center gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Search",
    variant: :h1,
    class: "mb-0 w-full text-center"
  ) %>

  <%= form_with url: root_path, method: :get, html: {
        class: "w-full",
        style: "--search-padding-y-lg: 1.25rem; --search-padding-inline-lg: 3.25rem;"
      } do %>
    <%= render FlatPack::Search::Component.new(
      name: "q",
      value: @q.presence,
      placeholder: "Try Ada, refund, sticky",
      max_width: :none,
      size: :lg
    ) %>
  <% end %>

  <% if @q.blank? %>
    <%= render FlatPack::Grid::Component.new(cols: 3, gap: :lg, class: "w-full") do %>
      <% @categories.each do |category| %>
        <%= render FlatPack::Card::Component.new do |card| %>
          <% card.header(divider: false) do %>
            <%= render FlatPack::SectionTitle::Component.new(title: category[:title], class: "my-0") %>
          <% end %>
          <% card.body do %>
            <p class="text-[var(--surface-muted-content-color)]"><%= category[:blurb] %></p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% elsif @pages.any? || @users.any? || @notes.any? %>
    <%= render FlatPack::Grid::Component.new(cols: 2, gap: :lg, class: "w-full") do %>
      <% @pages.each do |page| %>
        <%= render FlatPack::Card::Component.new(
          style: :interactive,
          clickable: true,
          href: page_path(page),
          padding: :none
        ) do |card| %>
          <% card.media(aspect_ratio: "16/9", padding: :none) do %>
            <%= image_tag page_cover_path(page),
                  alt: page.title,
                  class: "h-full w-full object-cover" %>
          <% end %>
          <% card.body do %>
            <p class="font-semibold text-[var(--surface-content-color)]"><%= page.title %></p>
            <p class="mt-1 text-sm text-[var(--surface-muted-content-color)]"><%= page_published_on(page) %></p>
          <% end %>
        <% end %>
      <% end %>

      <% @users.each do |user| %>
        <%= render FlatPack::Card::Component.new do |card| %>
          <% card.body do %>
            <p class="font-semibold text-[var(--surface-content-color)]"><%= user.name.presence || "—" %></p>
            <p class="mt-1 text-sm text-[var(--surface-muted-content-color)]"><%= user.email %></p>
          <% end %>
        <% end %>
      <% end %>

      <% @notes.each do |note| %>
        <%= render FlatPack::Card::Component.new do |card| %>
          <% card.body do %>
            <p class="font-semibold text-[var(--surface-content-color)]"><%= note.title %></p>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: "Nothing for that",
      description: "Try Ada, refund, or sticky."
    ) %>
  <% end %>
</div>
