<% dummy_page_nav(title: "As you type", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "As you type",
    subtitle: "Names show up while you hunt. No extra click.",
    variant: :h1
  ) %>

  <%= recording_studio_search.instant_search_field(
    models: [User],
    frame_id: "people_results",
    url: recording_studio_search.instant_search_path,
    param: :q,
    debounce_ms: 200,
    placeholder: "Try Ada or hopper"
  ) %>

  <turbo-frame id="people_results">
    <%= render "recording_studio_search/results", hits: @hits %>
  </turbo-frame>
</div>
