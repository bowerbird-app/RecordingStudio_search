<% dummy_page_nav(title: "Title first", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Title first",
    subtitle: "A hit in the title beats the same word buried in the body.",
    variant: :h1
  ) %>

  <%= form_with url: title_first_path, method: :get, html: { class: "w-full" } do %>
    <%= render FlatPack::Search::Component.new(
      name: "q",
      value: @q.presence,
      placeholder: "Try widgets",
      max_width: :none,
      size: :lg
    ) %>
  <% end %>

  <% if @q.blank? %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: "Type widgets",
      description: "One page wears it as a title. The other hides it in the body."
    ) %>
  <% elsif @pages.any? %>
    <%= render FlatPack::Table::Component.new(data: @pages, class: "text-sm") do |table| %>
      <% table.column(title: "Order") { |page| @pages.index(page) + 1 } %>
      <% table.column(title: "Title") { |page| page.title } %>
      <% table.column(title: "Hit") { |page| weighted_hit_label(page, @q) } %>
    <% end %>
  <% else %>
    <%= render FlatPack::Alert::Component.new(
      style: :info,
      title: "Nothing for that",
      description: "Try widgets. Typos still count."
    ) %>
  <% end %>
</div>
